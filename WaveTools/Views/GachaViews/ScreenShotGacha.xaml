<Page
    x:Class="WaveTools.Views.GachaViews.ScreenShotGacha"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="#181a1e">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Padding="16,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="ReportLoading" Width="20" Height="20" IsActive="True"/>
            <TextBlock x:Name="ReportStatus" Grid.Column="1" Text="正在生成报表"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="SaveReportButton" Grid.Column="2" Content="保存 PNG"
                    IsEnabled="False" Click="SaveReport_Click"/>
            <Button Grid.Column="3" Content="关闭" Click="CloseReport_Click"/>
        </Grid>
        <Grid Grid.Row="1" Background="#111317" Padding="12">
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                <Image x:Name="ReportImage" Width="640" Stretch="Uniform" VerticalAlignment="Top"/>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                    Spacing="16" Margin="16,10">
            <Button x:Name="PreviousPageButton" Content="上一页" IsEnabled="False" Click="PreviousPage_Click"/>
            <TextBlock x:Name="PageIndicator" Text="0 / 0" VerticalAlignment="Center"/>
            <Button x:Name="NextPageButton" Content="下一页" IsEnabled="False" Click="NextPage_Click"/>
        </StackPanel>
    </Grid>
</Page>
